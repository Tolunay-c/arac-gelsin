DirectoryIndex index.php
Options -Indexes

<FilesMatch "^\.">
  Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Real files/directories (assets, uploads, admin/*.php, …) are served
  # exactly as requested — the router below never sees these.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Optional clean admin URLs: /admin/settings -> admin/settings.php
  RewriteCond %{REQUEST_FILENAME}\.php -f
  RewriteRule ^admin/([a-zA-Z0-9_-]+)/?$ admin/$1.php [L]

  # Everything else goes through the public front controller (see
  # index.php + routes/web.php) so /hakkimizda, /filo, … resolve cleanly.
  RewriteRule ^ index.php [L]
</IfModule>
