{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.3"
    }
  },
  "routes": [
    { "src": "/(design-2|design-3)/assets/(.*)", "dest": "/$1/assets/$2" },
    { "src": "/(design-2|design-3)/uploads/(.*)", "dest": "/$1/uploads/$2" },
    { "src": "/assets/(.*)", "dest": "/assets/$1" },
    { "src": "/uploads/(.*)", "dest": "/uploads/$1" },
    { "src": "/favicon.ico", "status": 404 },
    { "src": "/(.*)", "dest": "/api/index.php" }
  ]
}
